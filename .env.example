# Local dev: leave unset — chatSocket.js falls back to ws(s)://<current-host>:8787
# Production (Vercel etc.): set to the deployed chat server's wss:// URL
# e.g. VITE_WS_URL=wss://your-app.up.railway.app
VITE_WS_URL=

# Server-side only (set this on Render/Railway/etc., NOT in the frontend build).
# Local dev: leave unset — server/store.js falls back to points.json/chatHistory.json.
# Production: set to a Postgres connection string so points/chat survive a redeploy
# (the container's own disk gets wiped on redeploy; an external DB doesn't).
# e.g. DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=
